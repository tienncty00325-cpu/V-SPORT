DB_URL=jdbc:sqlserver://<db-host>:1433;databaseName=<db-name>;encrypt=true;trustServerCertificate=true;sendStringParametersAsUnicode=true;
DB_USERNAME=<db-username>
DB_PASSWORD=<db-password>

# Chỉ cần cho local/dev khi DB dùng chứng chỉ tự ký. Không bật ở production
# nếu server có chứng chỉ hợp lệ - xem DBUtil.java.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

echo 'export PAYOS_CLIENT_ID="<payos-client-id>"' >> ~/.bashrc
echo 'export PAYOS_API_KEY="<payos-api-key>"' >> ~/.bashrc
echo 'export PAYOS_CHECKSUM_KEY="<payos-checksum-key>"' >> ~/.bashrc
MAPTILER_API_KEY=your_maptiler_api_key
